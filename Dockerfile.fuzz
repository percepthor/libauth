# syntax=docker/dockerfile:1
# the fuzz image: cerver from its local sources, libauth instrumented with libFuzzer
# build with --build-context cerver=<path to cerver> (see test/fuzz.sh)
FROM ubuntu:24.04

RUN apt-get update && apt-get install -y clang libclang-rt-18-dev libssl-dev libcurl4-openssl-dev make && apt-get clean

# cerver
COPY --from=cerver . /opt/cerver
RUN cd /opt/cerver \
	&& make clean \
	&& make TYPE=test CC=clang -j4 \
	&& make TYPE=test CC=clang install \
	&& make clean \
	&& ldconfig

WORKDIR /opt/libauth

COPY . .
RUN make clean && make TYPE=test CC=clang -j4 fuzz

CMD ["bash", "test/fuzz.sh"]
